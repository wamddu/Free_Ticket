      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{application=\"free-ticket\",uri!~\"/actuator.*\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"free-ticket\",uri!~\"/actuator.*\"}[5m])), 1e-9)",
          "legendFormat": "",
          "refId": "A",
          "range": true
